# Blokir semua akses web langsung ke folder ini (schema.sql, import.php, export/*.csv
# berisi data pribadi & password hash santri/pengurus). Folder ini hanya boleh diakses
# lewat CLI (php db/import.php) atau File Manager hosting, TIDAK lewat browser/URL.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
