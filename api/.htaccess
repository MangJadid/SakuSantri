# File library (bukan endpoint) - jangan boleh diakses langsung lewat URL,
# hanya boleh di-include oleh rest.php/rpc.php.
<FilesMatch "^(config|db|helpers)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
